spring.application.name=Application

db.url=jdbc:mysql://your-database-host:port/database-name
db.username=your-username
db.password=your-password
db.driver=com.mysql.cj.jdbc.Driver

# Optional HikariCP pool tuning
db.hikari.maximum-pool-size=10
db.hikari.minimum-idle=2
db.hikari.connection-timeout=30000
db.hikari.idle-timeout=600000
db.hikari.max-lifetime=1800000

server.port=8080

# Compress JSON/static responses to reduce transfer time.
server.compression.enabled=true
server.compression.min-response-size=1024
server.compression.mime-types=application/json,text/html,text/plain,text/css,application/javascript

spring.web.resources.static-locations=file:src/main/java/com/quanlycuahangthuoc/resources/static/
